# Copy this file to .env and replace the value before deployment.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=false
APP_HOST=127.0.0.1
PORT=5000

# Set this only after moving to PostgreSQL in production.
# DATABASE_URL=postgresql+psycopg://username:password@host:5432/hmis
